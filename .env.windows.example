# Bot Admin WhatsApp (.exe untuk Windows — mode SQLite)

# Database: SQLite (file lokal, tanpa server Postgres)
DB_DRIVER=sqlite
SQLITE_PATH=bot_admin_whatsapp.db

# Server
PORT=8080

# Gowa API (go-whatsapp-web-multidevice) — jalankan gowa dulu di :3000
GOWA_BASE_URL=http://127.0.0.1:3000
GOWA_WEBHOOK_URL=http://127.0.0.1:8080/webhook/gowa
GOWA_WEBHOOK_SECRET=ubah-saya-webhook-secret

# Nomor admin WhatsApp (format internasional tanpa +)
ADMIN_PHONE=6285720300059

# Dashboard login (multi-user/multi-tenant)
# DASHBOARD_USER = email akun admin pertama (tenant 1); DASHBOARD_PASSWORD = passwordnya.
DASHBOARD_USER=admin@tokoku.id
DASHBOARD_PASSWORD=admin123
SESSION_SECRET=ubah-saya-session-secret-sangat-rahasia

# Izinkan siapa pun mendaftar toko baru di /admin/register
# ALLOW_REGISTRATION=true

# Broadcast (jeda antar pesan, detik)
BROADCAST_DELAY_SECONDS=7

# Nama toko
STORE_NAME=Toko Kita

# AI (opsional)
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
