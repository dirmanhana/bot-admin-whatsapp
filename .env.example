PORT=8080

# Database: PostgreSQL (wajib)
DATABASE_URL=postgres://dirman@127.0.0.1:5433/bot_admin_whatsapp?sslmode=disable

# Gowa API (go-whatsapp-web-multidevice)
GOWA_BASE_URL=http://127.0.0.1:3000
GOWA_WEBHOOK_URL=http://127.0.0.1:8080/webhook/gowa
GOWA_WEBHOOK_SECRET=ubah-saya-webhook-secret

# Nomor admin WhatsApp (format internasional tanpa +, mis. 628123456789)
ADMIN_PHONE=628123456789

# Dashboard login (multi-user/multi-tenant)
# DASHBOARD_USER/EMAIL = email akun admin pertama (tenant 1); DASHBOARD_PASSWORD = passwordnya.
# Tenant lain bisa mendaftar sendiri di /admin/register (matikan dengan ALLOW_REGISTRATION=false).
DASHBOARD_USER=admin@tokoku.id
DASHBOARD_PASSWORD=admin123
SESSION_SECRET=ubah-saya-session-secret-sangat-rahasia

# Izinkan siapa pun mendaftar toko baru di /admin/register (true/false)
# ALLOW_REGISTRATION=true

# Broadcast
BROADCAST_DELAY_SECONDS=7

# Keamanan dashboard
# LOGIN_MAX_ATTEMPTS=5        # batas gagal login sebelum terkunci
# LOGIN_LOCKOUT_MINUTES=15    # durasi terkunci

# Log webhook
# LOG_REDACT=true             # samarkan nomor HP & isi chat di log

# AI (opsional) — kosongkan untuk nonaktif. Bisa diatur dari Dashboard > AI & Data
# Penyedia: deepseek | groq | nim | gemini | custom
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# AI_DAILY_QUOTA=20           # kuota jawaban AI per pelanggan per hari

# AI_MAX_TOKENS=600           # batas token jawaban AI

# AI_MAX_PRODUCTS=15          # maks produk di konteks AI (kecil = lebih cepat)

# AI_MAX_HISTORY=15           # maks pesan riwayat percakapan (kecil = lebih cepat)
# Upload gambar produk
# UPLOAD_DIR=data/products
